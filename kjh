-- Server Script (в Roblox Studio)
local HttpService = game:GetService("HttpService")

-- Убедитесь, что ключ активирован и вставлен без пробелов
local API_KEY = "rbx_41d40d6e9de11e967604f8d2675dbbf9fa7cfe31c17ae21a"

local res = HttpService:RequestAsync({
    Url = "https://api.rblxvalue.com/v2/items/snowcannon",
    Method = "GET",
    Headers = { ["X-Api-Key"] = API_KEY },
})

if res.Success then
    local data = HttpService:JSONDecode(res.Body)
    local item = data.item
    
    -- value_source_b — это цена именно из Supreme Values
    local supremePrice = item.value_source_b
    local stability = item.stability -- "Stable", "Rising" и т.д.
    
    print(string.format("Предмет: %s", item.name))
    print(string.format("Цена в Supreme: %s", supremePrice))
    print(string.format("Тренд: %s", stability))
    
    -- Если предмета нет в Supreme, цена будет 0
    if supremePrice == 0 then
        print("Внимание: Этот предмет не оценивается в Supreme Values.")
    end
else
    -- Выводим код ошибки, если запрос не удался
    warn("Ошибка API:", res.StatusCode, res.StatusMessage)
end
