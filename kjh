-- 🔑 Ключ API
local API_KEY = "rbx_aa58f767fc32b5ea3b44ad89bee8aa079cf66a90b0d6f13b"
local BASE_URL = "https://api.rblxvalue.com/v2/items/"
local cache = {}

local HttpFn = request or http_request or (syn and syn.request) or (delta and delta.request)
if not HttpFn then return end

-- Безопасное получение родителя для GUI
local function GetSafeGuiParent()
    local success, hui = pcall(function() return gethui() end)
    if success and hui then return hui end
    return LocalPlayer:WaitForChild("PlayerGui")
end
local GUI_PARENT = GetSafeGuiParent()

-- Синхронный HTTP-запрос с таймаутом
local function SyncRequest(url)
    local res = nil
    local finished = false
    task.spawn(function()
        local ok, result = pcall(HttpFn, {
            Url = url,
            Method = "GET",
            Headers = { ["X-Api-Key"] = API_KEY }
        })
        if ok then res = result end
        finished = true
    end)
    
    local timeout = tick() + 5
    while not finished and tick() < timeout do
        task.wait(0.05)
    end
    return res
end

-- Запрос цены
local function FetchItemData(itemName)
    if not itemName or itemName == "" or itemName == "???" then return nil end
    if cache[itemName] and (tick() - cache[itemName].time < 300) then
        return cache[itemName].data
    end

    local slug = string.lower(string.gsub(itemName, "[%s%p]", "-"))
    local res = SyncRequest(BASE_URL .. slug)
    
    if not res or res.StatusCode ~= 200 then
        local fallback = SyncRequest("https://api.rblxvalue.com/v2/items?search=" .. HttpService:UrlEncode(itemName) .. "&limit=1")
        if fallback and fallback.StatusCode == 200 then res = fallback end
    end

    if res and res.StatusCode == 200 and res.Body then
        local ok, json = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if ok and json then
            local item = json.item or (json.items and json.items[1])
            if item then
                local data = {
                    Name = item.name,
                    Value = item.value_source_b or item.value or 0,
                    Stability = item.stability or "Stable"
                }
                cache[itemName] = { data = data, time = tick() }
                return data
            end
        end
    end
    return nil
end

-- Гибкий поиск окна трейда (ищет любой GUI со словом "trade")
local function FindTradeGui(playerGui)
    for _, gui in pairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and string.find(string.lower(gui.Name), "trade") and gui.Enabled then
            return gui
        end
    end
    return nil
end

-- Гибкий поиск папок с офферами
local function GetOffers(tradeGui)
    local yourOffer, theirOffer
    local container = tradeGui:FindFirstChild("Container")
    local trade = container and container:FindFirstChild("Trade")
    if trade then
        yourOffer = trade:FindFirstChild("YourOffer")
        theirOffer = trade:FindFirstChild("TheirOffer")
    end
    
    -- Если стандартные пути не найдены, ищем по всему интерфейсу
    if not yourOffer or not theirOffer then
        for _, v in pairs(tradeGui:GetDescendants()) do
            if v:IsA("GuiObject") then
                local n = string.lower(v.Name)
                if not yourOffer and n:find("youroffer") then yourOffer = v end
                if not theirOffer and n:find("theiroffer") then theirOffer = v end
            end
        end
    end
    return yourOffer, theirOffer
end

-- Извлечение названия предмета из слота
local function GetSlotName(slot)
    if not slot then return nil end
    -- Ищем явные метки
    local lbl = slot:FindFirstChild("ItemName") 
        or slot:FindFirstChild("Name") 
        or slot:FindFirstChild("ItemNameLabel")
    if lbl and lbl:IsA("TextLabel") and lbl.Text ~= "" and lbl.Text ~= "???" then
        return lbl.Text
    end
    -- Резервный поиск по всем текстовым меткам внутри слота
    for _, v in pairs(slot:GetDescendants()) do
        if v:IsA("TextLabel") and v.Text ~= "" and v.Text ~= "???" and v.Text ~= "Empty" and not v.Text:match("^%d+$") then
            return v.Text
        end
    end
    return nil
end

-- Сканирование стороны
local function ScanSide(folder)
    if not folder then return 0, {} end
    local total = 0
    local itemsFound = {}
    
    for _, child in pairs(folder:GetDescendants()) do
        -- Ищем слоты (обычно это Frame или ImageButton)
        if (child:IsA("Frame") or child:IsA("ImageButton")) and child.Visible then
            local name = GetSlotName(child)
            if name then
                local itemData = FetchItemData(name)
                if itemData then
                    total = total + itemData.Value
                    table.insert(itemsFound, itemData)
                end
            end
        end
    end
    return total, itemsFound
end

