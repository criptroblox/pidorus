-- Асинхронный запрос (не вешает игру)
local function FetchItemAsync(itemName, callback)
    if not itemName or itemName == "" or itemName == "???" then return end
    
    itemName = itemName:match("^%s*(.-)%s*$") -- Очистка пробелов
    
    -- Если есть в кэше, отдаем сразу
    if cache[itemName] then
        callback(cache[itemName])
        return
    end
    
    -- Если запрос уже отправлен, ждем
    if pendingRequests[itemName] then return end
    pendingRequests[itemName] = true

    task.spawn(function()
        local slug = string.lower(string.gsub(itemName, "[%s%p]+", "-"))
        local url = BASE_URL .. slug
        
        local ok, res = pcall(HttpFn, {
            Url = url,
            Method = "GET",
            Headers = { ["X-Api-Key"] = API_KEY }
        })

        if ok and res and res.StatusCode == 200 and res.Body then
            local decodeOk, json = pcall(function() return HttpService:JSONDecode(res.Body) end)
            if decodeOk and json and json.item then
                local item = json.item
                local val = item.value_source_b or item.value or 0
                
                -- Если Supreme пустой, берем MM2Values
                if val == 0 then val = item.value_source_a or 0 end

                local data = {
                    Name = item.name,
                    Value = val,
                    Stability = item.stability or "Stable"
                }
                cache[itemName] = data
                log("✅ УСПЕХ:", itemName, "| Цена:", val, "| Тренд:", data.Stability)
                callback(data)
            else
                log("❌ ОШИБКА JSON для:", itemName, "| Ответ:", res.Body)
            end
        else
            -- Логируем ошибку API (например, 401 Unauthorized или 429 Too Many Requests)
            local status = res and res.StatusCode or "НЕТ ОТВЕТА"
            local body = res and res.Body or "пусто"
            log("❌ ОШИБКА API:", itemName, "| Код:", status, "| Ответ:", body)
        end
        
        pendingRequests[itemName] = nil
    end)
end

local function FindTradeGui(playerGui)
    for _, gui in pairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and string.find(string.lower(gui.Name), "trade") and gui.Enabled then
            return gui
        end
    end
    return nil
end

local function GetOffers(tradeGui)
    local yourOffer, theirOffer
    local container = tradeGui:FindFirstChild("Container")
    local trade = container and container:FindFirstChild("Trade")
    if trade then
        yourOffer = trade:FindFirstChild("YourOffer")
        theirOffer = trade:FindFirstChild("TheirOffer")
    end
    
    if not yourOffer or not theirOffer then
        for _, v in pairs(tradeGui:GetDescendants()) do
            if v:IsA("GuiObject") then
                local n = string.lower(v.Name)
                if not yourOffer and n:find("youroffer") then yourOffer = v end
                if not theirOffer and n:find("theiroffer") then theirOffer = v end
            end
        end
    end
    return yourOffer, theirOffer
end

-- Умный поиск названия (убирает мусорные тексты и числа)
local function GetSlotName(slot)
    if not slot then return nil end

    local attr = slot:GetAttribute("ItemName") or slot:GetAttribute("Name")
    if attr then return tostring(attr) end

    for _, v in pairs(slot:GetDescendants()) do
        if v:IsA("TextLabel") and v.Text ~= "" and v.Text ~= "???" and v.Text ~= "Empty" then
            -- Игнорируем текст, если это просто число (например, количество)
            if not v.Text:match("^[xX]?%s*%d+$") and #v.Text > 2 then
                return v.Text
            end
        end
    end
    return nil
end

local function GetQuantity(slot)
    for _, v in pairs(slot:GetDescendants()) do
        if v:IsA("TextLabel") then
            local match = v.Text:match("^[xX]?%s*(%d+)$")
            if match then return tonumber(match) end
        end
    end
    return 1
end

-- Сканирование без ожидания API
local function ScanSide(folder, panelName)
    if not folder then return end
    local total = 0
    local trends = { Rising = 0, Dropping = 0 }
    local foundItems = {}

    -- Сначала собираем все слоты и названия
    for _, child in pairs(folder:GetDescendants()) do
        if (child:IsA("Frame") or child:IsA("ImageButton") or child:IsA("ViewportFrame")) and child.Visible then
            local name = GetSlotName(child)
            if name then
                local qty = GetQuantity(child)
                table.insert(foundItems, {name = name, qty = qty, slot = child})
            end
        end
    end

    -- Если предметов нет, обнуляем
    if #foundItems == 0 then
        return 0, 0, 0
    end

    -- Обрабатываем каждый предмет (мгновенно из кэша, или в фоне)
    for _, itemInfo in pairs(foundItems) do
        local itemName = itemInfo.name
        local qty = itemInfo.qty
        
        FetchItemAsync(itemName, function(data)
            local itemTotal = data.Value * qty
            total = total + itemTotal
            
            if data.Stability == "Rising" then trends.Rising = trends.Rising + 1
            elseif data.Stability == "Dropping" then trends.Dropping = trends.Dropping + 1 end
            
            -- Обновляем UI после каждого полученного предмета
            local trendIcon = "➖"
            if trends.Rising > trends.Dropping then trendIcon = "📈"
            elseif trends.Dropping > trends.Rising then trendIcon = "📉" end
            
            panelName.Text = string.format("Offer: %d val %s", total, trendIcon)
        end)
    end
end

