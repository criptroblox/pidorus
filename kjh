-- Цикл сканирования
task.spawn(function()
    while task.wait(2) do -- Раз в 2 секунды, чтобы не превышать лимит API
        pcall(function()
            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
            local tradeGui = playerGui and FindTradeGui(playerGui)
            if not tradeGui then return end
            
            local yourOffer, theirOffer = GetOffers(tradeGui)
            if not yourOffer or not theirOffer then return end

            log("--- Начинаю сканирование трейда ---")
            local myTotal, myItems = ScanSide(yourOffer)
            local theirTotal, theirItems = ScanSide(theirOffer)

            local function getTrend(items)
                if not items or #items == 0 then return "➖" end
                local r, d = 0, 0
                for _, i in pairs(items) do
                    if i.Stability == "Rising" then r = r + 1
                    elseif i.Stability == "Dropping" then d = d + 1 end
                end
                if r > d then return "📈" elseif d > r then return "📉" end
                return "➖"
            end

            myPanel.Text = string.format("Your Offer: %d value %s", myTotal, getTrend(myItems))
            theirPanel.Text = string.format("Their Offer: %d value %s", theirTotal, getTrend(theirItems))
            
            if myTotal > theirTotal and theirTotal > 0 then
                myPanel.BackgroundColor3 = Color3.fromRGB(40, 120, 40)
            elseif theirTotal > myTotal and myTotal > 0 then
                theirPanel.BackgroundColor3 = Color3.fromRGB(40, 120, 40)
            else
                myPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                theirPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
            end
        end)
    end
end)
