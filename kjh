--[[
    MM2 Trade Scanner (Direct MM2Values Parser)
    Напрямую парсит данные с официального сайта mm2values.com
--]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Официальный сайт MM2Values
local MM2V_URL = "https://mm2values.com/"

local HttpFn = request or http_request or (syn and syn.request) or (delta and delta.request)
if not HttpFn then 
    return StarterGui:SetCore("SendNotification", {Title = "Ошибка", Text = "HTTP-функции недоступны.", Duration = 5})
end

-- ================== ПАРСИНГ САЙТА MM2VALUES ==================
local function FetchMM2Values()
    print("[MM2V] Загрузка актуальных цен с mm2values.com...")
    local res = HttpFn({
        Url = MM2V_URL,
        Method = "GET",
        Headers = {
            ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        }
    })

    if not res or res.StatusCode ~= 200 or not res.Body then
        warn("[MM2V] Не удалось загрузить сайт. Код:", res and res.StatusCode or "Нет ответа")
        return {}
    end

    local items = {}
    local body = res.Body

    -- Ищем таблицы значений в HTML (обычно предметы лежат в тегах <tr>...</tr>)
    -- Формат обычно: <td>Название</td>...<td>Значение</td>
    for name, valStr in body:gmatch('<td[^>]*class="[^"]*item-name[^"]*"[^>]*>(.-)</td>.-<td[^>]*class="[^"]*item-value[^"]*"[^>]*>(.-)</td>') do
        local cleanName = name:gsub("<.->", ""):gsub("^%s+", ""):gsub("%s+$", "")
        local cleanVal = valStr:gsub("<.->", ""):gsub("[^%d]", "") -- Оставляем только цифры
        
        if cleanName ~= "" and cleanVal ~= "" then
            items[string.lower(cleanName)] = tonumber(cleanVal) or 0
        end
    end

    -- Резервный парсинг (если классы отличаются)
    if next(items) == nil then
        for name, valStr in body:gmatch('<tr.-<td[^>]*>(.-)</td>.-<td[^>]*>(.-)</td>.-</tr>') do
            local cleanName = name:gsub("<.->", ""):gsub("^%s+", ""):gsub("%s+$", "")
            -- Проверяем, что это не заголовок таблицы
            if #cleanName > 2 and not cleanName:lower():find("item") and not cleanName:lower():find("value") then
                local cleanVal = valStr:gsub("<.->", ""):gsub("[^%d]", "")
                if cleanVal ~= "" then
                    items[string.lower(cleanName)] = tonumber(cleanVal) or 0
                end
            end
        end
    end

    print("[MM2V] Успешно распознано предметов:", ... -- считаем количество
    local count = 0
    for _ in pairs(items) do count = count + 1 end
    print("[MM2V] Всего предметов в базе:", count)
    
    return items
end

-- Загружаем базу один раз при запуске
local VALUE_DB = FetchMM2Values()

local function FindItemValue(itemName)
    if not itemName or itemName == "" then return 0 end
    local cleanName = string.lower(itemName:match("^%s*(.-)%s*$"))
    
    -- Прямое совпадение
    if VALUE_DB[cleanName] then return VALUE_DB[cleanName] end
    
    -- Поиск по частичному совпадению (если игра обрезала название)
    for dbName, val in pairs(VALUE_DB) do
        if dbName:find(cleanName) or cleanName:find(dbName) then
            return val
        end
    end
    return 0
end

-- ================== ИНТЕРФЕЙС ==================
local function GetSafeGuiParent()
    local ok, hui = pcall(function() return gethui() end)
    if ok and hui then return hui end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local oldGui = GetSafeGuiParent():FindFirstChild("MM2_TradeScanner")
if oldGui then oldGui:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "MM2_TradeScanner"
gui.ResetOnSpawn = false
gui.Parent = GetSafeGuiParent()

local function CreatePanel(name, pos)
    local p = Instance.new("TextLabel")
    p.Size = UDim2.new(0, 260, 0, 40)
    p.Position = pos
    p.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    p.TextColor3 = Color3.fromRGB(255, 255, 255)
    p.Font = Enum.Font.GothamBold
    p.TextSize = 15
    p.Text = name .. ": 0 val ➖"
    p.Visible = false
    p.Parent = gui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = p
    return p
end

local myPanel = CreatePanel("Your Offer", UDim2.new(0.05, 0, 0.12, 0))
local theirPanel = CreatePanel("Their Offer", UDim2.new(0.55, 0, 0.12, 0))

-- ================== СТРОГИЙ ПОИСК СЛОТОВ ==================
local function FindTradeGui(playerGui)
    for _, g in pairs(playerGui:GetChildren()) do
        if g:IsA("ScreenGui") and string.find(string.lower(g.Name), "trade") and g.Enabled then
            return g
        end
    end
    return nil
end

local function GetOffers(tradeGui)
    local container = tradeGui:FindFirstChild("Container")
    local trade = container and container:FindFirstChild("Trade")
    if trade then
        return trade:FindFirstChild("YourOffer"), trade:FindFirstChild("TheirOffer")
    end
    return nil, nil
end

local function GetValidSlotName(slot)
    if not slot then return nil end
    for _, v in pairs(slot:GetDescendants()) do
        if v:IsA("TextLabel") or v:IsA("TextBox") then
            local t = v.Text
            if t and t ~= "" then
                local lowerT = string.lower(t)
                local isNumber = t:match("^[xX]?%s*%d+$") or t:match("^%d+%s*/%s*%d+$")
                local isSystem = lowerT:find("empty") or lowerT:find("slot") or lowerT:find("offer") 
                              or lowerT:find("add") or lowerT:find("trade") or lowerT:find("nothing") 
                              or lowerT:find("drag") or lowerT:find("ready")
                
                if not isNumber and not isSystem and t ~= "???" and #t > 2 then
                    return t
                end
            end
        end
    end
    return nil
end

local function ScanSide(folder, panel, label)
    if not folder then 
        if panel and panel.Parent then panel.Text = label .. ": 0 val ➖" end
        return 0 
    end

    local total = 0
    local foundSlots = {} 

    for _, child in pairs(folder:GetDescendants()) do
        if (child:IsA("Frame") or child:IsA("ImageButton")) and child.Visible and not foundSlots[child] then
            local itemName = GetValidSlotName(child)
            if itemName then
                local itemValue = FindItemValue(itemName)
                if itemValue > 0 then
                    local qty = 1
                    for _, txt in pairs(child:GetDescendants()) do
                        if txt:IsA("TextLabel") then
                            local num = txt.Text:match("^[xX]?%s*(%d+)$")
                            if num and tonumber(num) > 1 then
                                qty = tonumber(num)
                                break
                            end
                        end
                    end
                    total = total + (itemValue * qty)
                    foundSlots[child] = true
                end
            end
        end
    end

    -- Обновляем текст только если панель существует
    if panel and panel.Parent then
        panel.Text = string.format("%s: %s val ➖", label, tostring(total))
    end
    return total
end

-- ================== ЦИКЛ МОНИТОРИНГА ==================
task.spawn(function()
    local lastSeen, lastScan = 0, 0

    while task.wait(0.2) do
        pcall(function()
            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
            local tradeGui = playerGui and FindTradeGui(playerGui)

            if tradeGui then
                lastSeen = tick()
                if myPanel then myPanel.Visible = true end
                if theirPanel then theirPanel.Visible = true end

                if tick() - lastScan > 1.0 then
                    lastScan = tick()
                    local yourOffer, theirOffer = GetOffers(tradeGui)

                    if yourOffer and theirOffer then
                        local myTotal = ScanSide(yourOffer, myPanel, "Your Offer")
                        local theirTotal = ScanSide(theirOffer, theirPanel, "Their Offer")

                        if myTotal < theirTotal and theirTotal > 0 then
                            myPanel.BackgroundColor3 = Color3.fromRGB(40, 120, 40)
                            theirPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                        elseif theirTotal < myTotal and myTotal > 0 then
                            theirPanel.BackgroundColor3 = Color3.fromRGB(40, 120, 40)
                            myPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                        else
                            myPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                            theirPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                        end
                    end
                end
            else
                if tick() - lastSeen > 2 then
                    if myPanel then myPanel.Visible = false end
                    if theirPanel then theirPanel.Visible = false end
                end
            end
        end)
    end
end)

print("[MM2 Scanner] Скрипт успешно запущен! Используются данные MM2Values.")
