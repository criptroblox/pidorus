-- ВСТАВЬТЕ СЮДА ВАШ НОВЫЙ API-КЛЮЧ RBLXVALUE (после перегенерации старого!)
local API_KEY = "rbx_aa58f767fc32b5ea3b44ad89bee8aa079cf66a90b0d6f13b"
local BASE_URL = "https://api.rblxvalue.com/v2/items/"

-- Универсальный поиск HTTP-функции в Delta (request или http_request)
local HttpFn = request or http_request or (syn and syn.request) or (delta and delta.request) or (fluxus and fluxus.request)
if not HttpFn then
    return game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Ошибка Executor",
        Text = "Delta не поддерживает HTTP-запросы в этой версии.",
        Duration = 5
    })
end

-- Функция запроса данных с учетом таймаута (Delta иногда зависает на некоторых доменах)
local function SafeHttpRequest(options)
    local response = nil
    local done = false
    
    task.spawn(function()
        local success, res = pcall(HttpFn, options)
        if success then response = res end
        done = true
    end)
    
    local timeout = tick() + 8 -- 8 секунд на ответ
    while not done and tick() < timeout do
        task.wait(0.1)
    end
    
    return response
end

-- Функция получения информации о предмете
local function GetItemData(itemSlug)
    local url = BASE_URL .. string.lower(itemSlug)
    
    local res = SafeHttpRequest({
        Url = url,
        Method = "GET",
        Headers = {
            ["X-Api-Key"] = API_KEY
        }
    })
    
    if res and res.StatusCode == 200 and res.Body then
        local decodeSuccess, data = pcall(function()
            return game:GetService("HttpService"):JSONDecode(res.Body)
        end)
        
        if decodeSuccess and data and data.item then
            local item = data.item
            return {
                Name = item.name,
                Value = item.value_source_b or item.value_source_a or 0, -- Цена Supreme Values
                Stability = item.stability or "Stable", -- "Rising", "Dropping", "Stable"
                Demand = item.demand or "N/A"
            }
        end
    end
    return nil
end

