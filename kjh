--[[
    MM2 Trade Scanner (BloxUltra API Edition) - FIXED
    Данные: https://bloxultra.com/api/values/mm2
    Без ключей и лимитов. База кэшируется локально.
--]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local API_URL = "https://bloxultra.com/api/values/mm2"
local DB_FILE = "mm2_bloxultra_db.json"

local HttpFn = request or http_request or (syn and syn.request) or (delta and delta.request)
if not HttpFn then return end

-- ================== ЗАГРУЗКА БАЗЫ ==================
local function LoadDatabase()
    if isfile and isfile(DB_FILE) then
        local success, content = pcall(readfile, DB_FILE)
        if success and content and content ~= "" then
            local decodeSuccess, data = pcall(function() return HttpService:JSONDecode(content) end)
            if decodeSuccess and type(data) == "table" then
                print("[DB] База загружена из файла. Предметов:", #data)
                return data
            end
        end
    end

    print("[DB] Загрузка базы с BloxUltra API...")
    local res = HttpFn({ Url = API_URL, Method = "GET" })
    if res and res.StatusCode == 200 and res.Body then
        local ok, json = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if ok and json and json.items then
            local items = {}
            for _, item in pairs(json.items) do
                table.insert(items, {
                    Name = item.name or "Unknown",
                    Slug = item.slug or "unknown",
                    Value = item.value or 0,
                    Demand = item.demand or "Medium" -- High, Medium, Low
                })
            end
            if #items > 0 then
                local success, encoded = pcall(function() return HttpService:JSONEncode(items) end)
                if success and writefile then writefile(DB_FILE, encoded) end
                print("[DB] База сохранена. Предметов:", #items)
            end
            return items
        end
    else
        warn("[DB] Ошибка API:", res and res.StatusCode or "Нет ответа")
    end
    return {}
end

local ITEM_DB = LoadDatabase()
local ITEM_INDEX = {}
for _, item in pairs(ITEM_DB) do
    if item.Slug then ITEM_INDEX[string.lower(item.Slug)] = item end
end

local function FindItem(name)
    if not name or name == "" then return nil end
    local slug = string.lower(string.gsub(name, "[%s%p]+", "-"))
    if ITEM_INDEX[slug] then return ITEM_INDEX[slug] end
    for _, item in pairs(ITEM_DB) do
        if item.Name and string.lower(item.Name) == string.lower(name) then
            return item
        end
    end
    return nil
end

-- ================== ИНТЕРФЕЙС ==================
local function GetGuiParent()
    local ok, hui = pcall(function() return gethui() end)
    if ok and hui then return hui end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local oldGui = GetGuiParent():FindFirstChild("MM2_TradeScanner")
if oldGui then oldGui:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "MM2_TradeScanner"
gui.ResetOnSpawn = false
gui.Parent = GetGuiParent()

local function MakePanel(name, pos)
    local p = Instance.new("TextLabel")
    p.Size = UDim2.new(0, 260, 0, 40)
    p.Position = pos
    p.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    p.TextColor3 = Color3.fromRGB(255, 255, 255)
    p.Font = Enum.Font.GothamBold
    p.TextSize = 15
    p.Text = name .. ": 0 val ➖"
    p.Visible = false
    p.Parent = gui
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = p
    return p
end

local myPanel = MakePanel("Your Offer", UDim2.new(0.05, 0, 0.12, 0))
local theirPanel = MakePanel("Their Offer", UDim2.new(0.55, 0, 0.12, 0))

-- ================== ПОИСК ТРЕЙДА ==================
local function FindTradeGui(pg)
    for _, g in pairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and string.find(string.lower(g.Name), "trade") and g.Enabled then
            return g
        end
    end
    return nil
end

local function GetOffers(tg)
    local c = tg:FindFirstChild("Container")
    local t = c and c:FindFirstChild("Trade")
    if t then
        return t:FindFirstChild("YourOffer"), t:FindFirstChild("TheirOffer")
    end
    return nil, nil
end

-- Строгий фильтр: игнорируем числа, слоты и системный текст
local function GetSlotName(slot)
    if not slot then return nil end
    for _, v in pairs(slot:GetDescendants()) do
        if v:IsA("TextLabel") or v:IsA("TextBox") then
            local txt = v.Text
            if txt and txt ~= "" then
                local low = string.lower(txt)
                local isNum = txt:match("^[xX]?%s*%d+$") or txt:match("^%d+%s*/%s*%d+$")
                local isSys = low:find("empty") or low:find("slot") or low:find("offer")
                           or low:find("add") or low:find("trade") or low:find("nothing")
                           or low:find("drag") or low:find("ready")
                if not isNum and not isSys and txt ~= "???" and #txt > 2 then
                    return txt
                end
            end
        end
    end
    return nil
end

-- Сканирование с полным сбросом в 0
local function ScanSide(folder, panel, label)
    if not folder then
        if panel then panel.Text = label .. ": 0 val ➖" end
        return 0
    end

    local total = 0
    local found = {}
    local demandRising, demandDropping = 0, 0

    for _, child in pairs(folder:GetDescendants()) do
        if (child:IsA("Frame") or child:IsA("ImageButton")) and child.Visible and not found[child] then
            local itemName = GetSlotName(child)
            if itemName then
                local data = FindItem(itemName)
                if data then
                    local qty = 1
                    for _, t in pairs(child:GetDescendants()) do
                        if t:IsA("TextLabel") then
                            local n = t.Text:match("^[xX]?%s*(%d+)$")
                            if n and tonumber(n) > 1 then qty = tonumber(n) break end
                        end
                    end
                    total = total + (data.Value * qty)
                    if data.Demand == "High" then demandRising = demandRising + 1
                    elseif data.Demand == "Low" then demandDropping = demandDropping + 1 end
                    found[child] = true
                end
            end
        end
    end

    local icon = "➖"
    if demandRising > demandDropping then icon = "📈"
    elseif demandDropping > demandRising then icon = "📉" end

    if panel then
        panel.Text = string.format("%s: %d val %s", label, total, icon)
    end
    return total
end

-- ================== МОНИТОРИНГ ==================
task.spawn(function()
    local lastSeen, lastScan = 0, 0

    while task.wait(0.2) do
        pcall(function()
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            local tg = pg and FindTradeGui(pg)

            if tg then
                lastSeen = tick()
                myPanel.Visible = true
                theirPanel.Visible = true

                if tick() - lastScan > 1.0 then
                    lastScan = tick()
                    local myOff, theirOff = GetOffers(tg)

                    if myOff and theirOff then
                        local myTotal = ScanSide(myOff, myPanel, "Your Offer")
                        local theirTotal = ScanSide(theirOff, theirPanel, "Their Offer")

                        if myTotal < theirTotal and theirTotal > 0 then
                            myPanel.BackgroundColor3 = Color3.fromRGB(40, 120, 40)
                            theirPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                        elseif theirTotal < myTotal and myTotal > 0 then
                            theirPanel.BackgroundColor3 = Color3.fromRGB(40, 120, 40)
                            myPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                        else
                            myPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                            theirPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                        end
                    end
                end
            else
                if tick() - lastSeen > 2 then
                    myPanel.Visible = false
                    theirPanel.Visible = false
                end
            end
        end)
    end
end)

pcall(function()
    local sg = game:GetService("StarterGui")
    if sg and sg.SetCore then
        sg:SetCore("SendNotification", {Title = "MM2 Scanner", Text = "Данные BloxUltra загружены!", Duration = 3})
    end
end)
