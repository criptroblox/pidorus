-- Синхронный HTTP-запрос
local function SyncRequest(url)
    local res = nil
    local finished = false
    task.spawn(function()
        local ok, result = pcall(HttpFn, {
            Url = url,
            Method = "GET",
            Headers = { ["X-Api-Key"] = API_KEY }
        })
        if ok then res = result end
        finished = true
    end)
    
    local timeout = tick() + 5
    while not finished and tick() < timeout do task.wait(0.05) end
    return res
end

-- Запрос цены с защитой от ошибок API
local function FetchItemData(itemName)
    if not itemName or itemName == "" or itemName == "???" then return nil end
    
    -- Очищаем название от лишних пробелов по краям
    itemName = itemName:match("^%s*(.-)%s*$")

    if cache[itemName] and (tick() - cache[itemName].time < 300) then
        return cache[itemName].data
    end

    -- Генерируем слаг (Chroma Evergreen -> chroma-evergreen)
    local slug = string.lower(string.gsub(itemName, "[%s%p]+", "-"))
    log("Запрос к API по слагу:", slug)
    
    local res = SyncRequest(BASE_URL .. slug)
    
    if res and res.StatusCode == 200 and res.Body then
        local ok, json = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if ok and json and json.item then
            local item = json.item
            local val = item.value_source_b or item.value or 0
            
            -- Если Supreme пустой (0), берем MM2Values
            if val == 0 then 
                val = item.value_source_a or 0 
                log(" -> Цена Supreme не найдена, взята цена MM2Values:", val)
            end

            local data = {
                Name = item.name,
                Value = val,
                Stability = item.stability or "Stable"
            }
            cache[itemName] = { data = data, time = tick() }
            return data
        end
    end
    log("❌ Ошибка API или предмет не найден:", itemName)
    return nil
end

local function FindTradeGui(playerGui)
    for _, gui in pairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and string.find(string.lower(gui.Name), "trade") and gui.Enabled then
            return gui
        end
    end
    return nil
end

local function GetOffers(tradeGui)
    local yourOffer, theirOffer
    local container = tradeGui:FindFirstChild("Container")
    local trade = container and container:FindFirstChild("Trade")
    if trade then
        yourOffer = trade:FindFirstChild("YourOffer")
        theirOffer = trade:FindFirstChild("TheirOffer")
    end
    
    if not yourOffer or not theirOffer then
        for _, v in pairs(tradeGui:GetDescendants()) do
            if v:IsA("GuiObject") then
                local n = string.lower(v.Name)
                if not yourOffer and n:find("youroffer") then yourOffer = v end
                if not theirOffer and n:find("theiroffer") then theirOffer = v end
            end
        end
    end
    return yourOffer, theirOffer
end

-- ГЛУБОКИЙ поиск названия (включая скрытые элементы и атрибуты)
local function GetSlotName(slot)
    if not slot then return nil end

    -- 1. Атрибуты
    local attr = slot:GetAttribute("ItemName") or slot:GetAttribute("Name")
    if attr then return tostring(attr) end

    -- 2. StringValues
    local val = slot:FindFirstChild("ItemName") or slot:FindFirstChildOfClass("StringValue")
    if val and val:IsA("StringValue") and val.Value ~= "" then return val.Value end

    -- 3. Текстовые метки (включая невидимые)
    for _, v in pairs(slot:GetDescendants()) do
        if v:IsA("TextLabel") and v.Text ~= "" and v.Text ~= "???" and v.Text ~= "Empty" then
            -- Игнорируем числа (это может быть количество) и слишком короткие тексты
            if not v.Text:match("^[xX]?%d+$") and #v.Text > 2 then
                return v.Text
            end
        end
    end
    return nil
end

-- Поиск количества (x5 или просто 5)
local function GetQuantity(slot)
    for _, v in pairs(slot:GetDescendants()) do
        if v:IsA("TextLabel") then
            local match = v.Text:match("^[xX]?%s*(%d+)$")
            if match then return tonumber(match) end
        end
    end
    return 1 -- По умолчанию 1 штука
end

local function ScanSide(folder)
    if not folder then return 0, {} end
    local total = 0
    local itemsFound = {}
    
    for _, child in pairs(folder:GetDescendants()) do
        if (child:IsA("Frame") or child:IsA("ImageButton") or child:IsA("ViewportFrame")) and child.Visible then
            local name = GetSlotName(child)
            if name then
                local qty = GetQuantity(child)
                local itemData = FetchItemData(name)
                if itemData then
                    local itemTotal = itemData.Value * qty
                    total = total + itemTotal
                    table.insert(itemsFound, itemData)
                    log("✅ Предмет:", name, "| Кол-во:", qty, "| Цена:", itemData.Value, "| Итог:", itemTotal)
                end
            end
        end
    end
    return total, itemsFound
end

