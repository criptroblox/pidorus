-- Обновление интерфейса и цвета значка тренда
local function UpdateUI(itemSlug)
    local data = GetItemData(itemSlug)
    if not data then
        ItemNameLbl.Text = "Ошибка / Предмет не найден"
        ValueLbl.Text = "--"
        TrendLbl.Text = "Нет данных"
        return
    end
    
    ItemNameLbl.Text = tostring(data.Name)
    ValueLbl.Text = tostring(data.Value) .. " Value"
    
    if data.Stability == "Rising" then
        TrendLbl.Text = "📈 РАСТЕТ"
        TrendLbl.TextColor3 = Color3.fromRGB(0, 255, 100)
    elseif data.Stability == "Dropping" then
        TrendLbl.Text = "📉 ПАДАЕТ"
        TrendLbl.TextColor3 = Color3.fromRGB(255, 60, 60)
    else
        TrendLbl.Text = "➖ СТАБИЛЕН"
        TrendLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end

