--[[
    MM2 Trade Scanner (Clean Slate & Strict Mode)
--]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Бесплатный API без ключа
local API_URL = "https://bloxultra.com/api/values/mm2"
local DB_FILE = "mm2_items_bloxultra.json"

local HttpFn = request or http_request or (syn and syn.request) or (delta and delta.request)
if not HttpFn then return end

-- ================== ЗАГРУЗКА БАЗЫ ==================
local function LoadDatabase()
    if isfile and isfile(DB_FILE) then
        local success, content = pcall(readfile, DB_FILE)
        if success and content and content ~= "" then
            local decodeSuccess, data = pcall(function() return HttpService:JSONDecode(content) end)
            if decodeSuccess and type(data) == "table" then
                return data
            end
        end
    end

    print("[DB] Загрузка базы с BloxUltra API...")
    local res = HttpFn({ Url = API_URL, Method = "GET" })
    if res and res.StatusCode == 200 and res.Body then
        local ok, json = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if ok and json and json.items then
            local items = {}
            for _, item in pairs(json.items) do
                table.insert(items, {
                    Name = item.name or "Unknown",
                    Slug = item.slug or "unknown",
                    Value = item.value or 0,
                    Stability = "Stable"
                })
            end
            if #items > 0 then
                local success, encoded = pcall(function() return HttpService:JSONEncode(items) end)
                if success and writefile then writefile(DB_FILE, encoded) end
            end
            return items
        end
    end
    return {}
end

local ITEM_DB = LoadDatabase()
local ITEM_INDEX = {}
for _, item in pairs(ITEM_DB) do
    if item.Slug then ITEM_INDEX[string.lower(item.Slug)] = item end
end

local function FindItemByName(name)
    if not name or name == "" then return nil end
    local slug = string.lower(string.gsub(name, "[%s%p]+", "-"))
    if ITEM_INDEX[slug] then return ITEM_INDEX[slug] end
    for _, item in pairs(ITEM_DB) do
        if item.Name and string.lower(item.Name) == string.lower(name) then
            return item
        end
    end
    return nil
end

-- ================== ИНТЕРФЕЙС ==================
local function GetSafeGuiParent()
    local ok, hui = pcall(function() return gethui() end)
    if ok and hui then return hui end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local gui = Instance.new("ScreenGui")
gui.Name = "MM2_TradeScanner"
gui.ResetOnSpawn = false
gui.Parent = GetSafeGuiParent()

local function CreatePanel(name, pos)
    local p = Instance.new("TextLabel")
    p.Size = UDim2.new(0, 260, 0, 40)
    p.Position = pos
    p.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    p.TextColor3 = Color3.fromRGB(255, 255, 255)
    p.Font = Enum.Font.GothamBold
    p.TextSize = 15
    p.Text = name .. ": 0 val"
    p.Visible = false
    p.Parent = gui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = p
    return p
end

local myPanel = CreatePanel("Your Offer", UDim2.new(0.05, 0, 0.12, 0))
local theirPanel = CreatePanel("Their Offer", UDim2.new(0.55, 0, 0.12, 0))

-- ================== СТРОГИЙ ПОИСК ЭЛЕМЕНТОВ ==================
local function FindTradeGui(playerGui)
    for _, g in pairs(playerGui:GetChildren()) do
        if g:IsA("ScreenGui") and string.find(string.lower(g.Name), "trade") and g.Enabled then
            return g
        end
    end
    return nil
end

local function GetOffers(tradeGui)
    local container = tradeGui:FindFirstChild("Container")
    local trade = container and container:FindFirstChild("Trade")
    if trade then
        return trade:FindFirstChild("YourOffer"), trade:FindFirstChild("TheirOffer")
    end
    return nil, nil
end

-- Строгий поиск названия предмета (игнорирует цифры, "Empty", "Slot" и т.д.)
local function GetSlotName(slot)
    if not slot then return nil end
    for _, v in pairs(slot:GetDescendants()) do
        if v:IsA("TextLabel") or v:IsA("TextBox") then
            local t = v.Text
            if t and t ~= "" then
                -- Игнорируем пустые слоты, цифры (количество слотов) и системный текст
                local isNumber = t:match("^[xX]?%s*%d+$")
                local isSystem = string.lower(t):find("empty") or string.lower(t):find("slot") or string.lower(t):find("offer") or string.lower(t):find("trade")
                
                if not isNumber and not isSystem and t ~= "???" and t ~= "Nothing" and #t > 2 then
                    return t
                end
            end
        end
    end
    return nil
end

-- Подсчет количества (если лежит стак)
local function GetQuantity(slot)
    for _, v in pairs(slot:GetDescendants()) do
        if v:IsA("TextLabel") then
            local match = v.Text:match("^[xX]?%s*(%d+)$")
            if match then 
                local num = tonumber(match)
                if num > 1 then return num end
            end
        end
    end
    return 1
end

-- Сканирование с жестким сбросом (Clean Slate)
local function ScanSide(folder, panel, label)
    if not folder then 
        if panel and panel.Parent then panel.Text = label .. ": 0 val" end
        return 0 
    end

    local total = 0
    local foundItems = {}

    for _, child in pairs(folder:GetDescendants()) do
        -- Ищем только видимые слоты с предметами
        if (child:IsA("Frame") or child:IsA("ImageButton") or child:IsA("ViewportFrame")) and child.Visible then
            local ok, itemName = pcall(GetSlotName, child)
            if ok and itemName then
                local itemData = FindItemByName(itemName)
                if itemData then
                    local qty = GetQuantity(child)
                    total = total + (itemData.Value * qty)
                    foundItems[itemName] = true
                else
                    -- Если скрипт видит текст, но не находит его в базе, пишем в консоль
                    if not foundItems[itemName] then
                        warn("[Неизвестный предмет]:", itemName, "| Проверьте название в базе BloxUltra")
                        foundItems[itemName] = true
                    end
                end
            end
        end
    end

    -- Всегда обновляем интерфейс (даже если 0)
    if panel and panel.Parent then
        panel.Text = string.format("%s: %d val", label, total)
    end
    return total
end

-- ================== МОНИТОРИНГ ==================
task.spawn(function()
    local lastSeen, lastScan = 0, 0

    while task.wait(0.2) do
        pcall(function()
            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
            local tradeGui = playerGui and FindTradeGui(playerGui)

            if tradeGui then
                lastSeen = tick()
                if myPanel then myPanel.Visible = true end
                if theirPanel then theirPanel.Visible = true end

                if tick() - lastScan > 1.5 then
                    lastScan = tick()
                    local your, their = GetOffers(tradeGui)

                    if your and their then
                        -- Оборачиваем в pcall, чтобы не было вылетов
                        local s1, myTotal = pcall(ScanSide, your, myPanel, "Your Offer")
                        local s2, theirTotal = pcall(ScanSide, their, theirPanel, "Their Offer")

                        if s1 and s2 and type(myTotal) == "number" and type(theirTotal) == "number" then
                            if myTotal > theirTotal and theirTotal > 0 then
                                myPanel.BackgroundColor3 = Color3.fromRGB(40, 120, 40)
                            elseif theirTotal > myTotal and myTotal > 0 then
                                theirPanel.BackgroundColor3 = Color3.fromRGB(40, 120, 40)
                            else
                                myPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                                theirPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                            end
                        end
                    end
                end
            else
                if tick() - lastSeen > 2 then
                    if myPanel then myPanel.Visible = false end
                    if theirPanel then theirPanel.Visible = false end
                end
            end
        end)
    end
end)

print("[MM2 Scanner] Обновленный скрипт запущен!")
