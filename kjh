--[[
    MM2 Trade Supreme Value Scanner for Delta Executor
    Автоматический подсчет стоимости трейда (YourOffer / TheirOffer) с трендами
--]]

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local StarterGui = game:GetService("StarterGui")
local LocalPlayer = Players.LocalPlayer

-- 🔑 Встроенный API-ключ
local API_KEY = "rbx_aa58f767fc32b5ea3b44ad89bee8aa079cf66a90b0d6f13b"
local BASE_URL = "https://api.rblxvalue.com/v2/items/"
local cache = {}

-- Поиск HTTP-функции в инжекторе
local HttpFn = request or http_request or (syn and syn.request) or (delta and delta.request)
if not HttpFn then
    return StarterGui:SetCore("SendNotification", {
        Title = "Ошибка Delta",
        Text = "HTTP-запросы не поддерживаются в данной версии исполнителя.",
        Duration = 5
    })
end

-- Синхронный HTTP-запрос с таймаутом (для стабильности на телефонах)
local function SyncRequest(url)
    local res = nil
    local finished = false
    task.spawn(function()
        local ok, result = pcall(HttpFn, {
            Url = url,
            Method = "GET",
            Headers = { ["X-Api-Key"] = API_KEY }
        })
        if ok then res = result end
        finished = true
    end)
    
    local timeout = tick() + 6
    while not finished and tick() < timeout do
        task.wait(0.05)
    end
    return res
end

-- Получение цены и тренда предмета
local function FetchItemData(itemName)
    if not itemName or itemName == "" or itemName == "???" then return nil end
    
    if cache[itemName] and (tick() - cache[itemName].time < 300) then
        return cache[itemName].data
    end

    -- Формируем слаг (заменяем пробелы на дефисы, убираем спецсимволы)
    local slug = string.lower(string.gsub(itemName, "[%s%p]", "-"))
    local res = SyncRequest(BASE_URL .. slug)
    
    -- Резервный вариант (если прямой слад не сработал)
    if not res or res.StatusCode ~= 200 then
        local fallback = SyncRequest("https://api.rblxvalue.com/v2/items?search=" .. HttpService:UrlEncode(itemName) .. "&limit=1")
        if fallback and fallback.StatusCode == 200 then
            res = fallback
        end
    end

    if res and res.StatusCode == 200 and res.Body then
        local ok, json = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if ok and json then
            local item = json.item
            if not item and json.items and #json.items > 0 then
                item = json.items[1]
            end
            if item then
                local data = {
                    Name = item.name,
                    Value = item.value_source_b or item.value or 0,
                    Stability = item.stability or "Stable"
                }
                cache[itemName] = { data = data, time = tick() }
                return data
            end
        end
    end
    return nil
end

-- Вспомогательная функция для безопасного поиска TextLabel с названием предмета
local function GetSlotName(slot)
    if not slot then return nil end
    local lbl = slot:FindFirstChild("ItemName") 
        or slot:FindFirstChildOfClass("TextLabel") 
        or slot:FindFirstChild("Name")
    if lbl and lbl.Text ~= "" and lbl.Text ~= "???" then
        return lbl.Text
    end
    return nil
end

-- Анализ одной стороны трейда
local function ScanSide(folder)
    if not folder then return 0, {} end
    local total = 0
    local itemsFound = {}
    
    for _, child in pairs(folder:GetChildren()) do
        if child:IsA("Frame") and child.Visible then
            local name = GetSlotName(child)
            if name then
                local itemData = FetchItemData(name)
                if itemData then
                    total = total + itemData.Value
                    table.insert(itemsFound, itemData)
                end
            end
        end
    end
    return total, itemsFound
end

-- Создание интерфейса для трейда
local function CreateTradeOverlay()
    local old = CoreGui:FindFirstChild("MM2_TradeScanner")
    if old then old:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "MM2_TradeScanner"
    gui.ResetOnSpawn = false
    gui.Parent = (gethui and gethui()) or CoreGui

    -- Панель для ВАШЕГО оффера (слева вверху)
    local myPanel = Instance.new("TextLabel")
    myPanel.Name = "YourOfferPanel"
    myPanel.Size = UDim2.new(0, 260, 0, 40)
    myPanel.Position = UDim2.new(0.05, 0, 0.12, 0)
    myPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    myPanel.BackgroundTransparency = 0.2
    myPanel.TextColor3 = Color3.fromRGB(255, 255, 255)
    myPanel.Font = Enum.Font.GothamBold
    myPanel.TextSize = 15
    myPanel.Text = "Your Offer: 0 value ➖"
    myPanel.Parent = gui
    Instance.new("UICorner", myPanel).CornerRadius = UDim.new(0, 8)

    -- Панель для ИХ оффера (справа вверху)
    local theirPanel = Instance.new("TextLabel")
    theirPanel.Name = "TheirOfferPanel"
    theirPanel.Size = UDim2.new(0, 260, 0, 40)
    theirPanel.Position = UDim2.new(0.55, 0, 0.12, 0)
    theirPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    theirPanel.BackgroundTransparency = 0.2
    theirPanel.TextColor3 = Color3.fromRGB(255, 255, 255)
    theirPanel.Font = Enum.Font.GothamBold
    theirPanel.TextSize = 15
    theirPanel.Text = "Their Offer: 0 value ➖"
    theirPanel.Parent = gui
    Instance.new("UICorner", theirPanel).CornerRadius = UDim.new(0, 8)

    return myPanel, theirPanel
end

local myPanel, theirPanel = CreateTradeOverlay()

-- Основной цикл мониторинга окна трейда
task.spawn(function()
    while task.wait(1.2) do
        pcall(function()
            local tradeGui = LocalPlayer.PlayerGui:FindFirstChild("TradeGUI")
            if not tradeGui or not tradeGui.Enabled then
                myPanel.Visible = false
                theirPanel.Visible = false
                return
            end

            local yourOffer = tradeGui:FindFirstChild("Container") 
                and tradeGui.Container.Trade.YourOffer
            local theirOffer = tradeGui:FindFirstChild("Container") 
                and tradeGui.Container.Trade.TheirOffer

            if not yourOffer or not theirOffer then return end

            myPanel.Visible = true
            theirPanel.Visible = true

            local myTotal, myItems = ScanSide(yourOffer)
            local theirTotal, theirItems = ScanSide(theirOffer)

            -- Определение преобладающего тренда по каждой стороне
            local function getTrendText(items)
                if not items or #items == 0 then return "➖" end
                local rising, dropping = 0, 0
                for _, item in pairs(items) do
                    if item.Stability == "Rising" then rising = rising + 1
                    elseif item.Stability == "Dropping" then dropping = dropping + 1 end
                end
                if rising > dropping then return "📈" elseif dropping > rising then return "📉" end
                return "➖"
            end

            myPanel.Text = string.format("Your Offer: %d value %s", myTotal, getTrendText(myItems))
            theirPanel.Text = string.format("Their Offer: %d value %s", theirTotal, getTrendText(theirItems))
            
            -- Подсветка выгодности обмена
            if myTotal > theirTotal and theirTotal > 0 then
                myPanel.BackgroundColor3 = Color3.fromRGB(40, 120, 40) -- Вы отдаете больше
            elseif theirTotal > myTotal and myTotal > 0 then
                theirPanel.BackgroundColor3 = Color3.fromRGB(40, 120, 40) -- Вы получаете больше
            else
                myPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                theirPanel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
            end
        end)
    end
end)

StarterGui:SetCore("SendNotification", {
    Title = "Supreme Tracker",
    Text = "Мониторинг окна трейда запущен.",
    Duration = 3
})
